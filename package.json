{
  "name": "vsp",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.6"
  },
  "prisma": {
    "schema": "apps/api/prisma/schema.prisma"
  },
  "scripts": {
    "postinstall": "prisma generate --schema=apps/api/prisma/schema.prisma",
    "dev": "nx run-many -t serve -p api web --parallel=2",
    "serve:api": "nx serve api",
    "serve:web": "nx serve web",
    "build": "nx run-many -t build -p api web",
    "start:api": "node dist/apps/api/main.js",
    "typecheck": "nx run-many -t typecheck",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env apps/api/prisma/seed.ts",
    "db:studio": "prisma studio",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "nodemailer": "^6.9.16",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "rxjs": "~7.8.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tslib": "^2.6.3",
    "zod": "^3.23.8",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@nx/angular": "^19.8.0",
    "@nx/js": "^19.8.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.16",
    "esbuild": "^0.24.0",
    "nx": "^19.8.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "~5.5.4"
  }
}
