generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Category {
  OIL
  DRY_FRUIT
}

enum OrderStatus {
  PLACED
  CONFIRMED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum NotifyStatus {
  PENDING
  SENT
  FAILED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum OtpChannel {
  EMAIL
  SMS
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String?   @unique
  phone        String?   @unique
  passwordHash String
  role         Role      @default(USER)
  isVerified   Boolean   @default(false)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())

  otpCodes      OtpCode[]
  refreshTokens RefreshToken[]
  orders        Order[]
  review        Review?
  conversation  Conversation?
  gallery       GalleryItem[]
}

model OtpCode {
  id         String     @id @default(uuid())
  userId     String
  channel    OtpChannel
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Product {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String
  category    Category
  imageUrl    String?
  isActive    Boolean  @default(true)
  variants    ProductVariant[]

  @@index([category, isActive])
}

// Price and stock live on the variant (e.g. "1 L", "500 g"): that is what customers buy.
model ProductVariant {
  id         String  @id @default(uuid())
  productId  String
  label      String
  price      Decimal @db.Decimal(10, 2)
  stock      Int     @default(0)
  isActive   Boolean @default(true)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, label])
}

model Order {
  id            String       @id @default(uuid())
  number        Int          @unique @default(autoincrement())
  userId        String?      // null for guest orders
  customerName  String
  customerPhone String
  customerEmail String?
  addressLine   String
  city          String
  state         String
  pincode       String
  notes         String?
  status        OrderStatus  @default(PLACED)
  paymentMethod String       @default("COD")
  total         Decimal      @db.Decimal(10, 2)
  whatsapp      NotifyStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]

  @@index([userId, createdAt])
}

// Snapshot of name/label/price at purchase time so order history never changes.
model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  variantId    String?
  productName  String
  variantLabel String
  unitPrice    Decimal @db.Decimal(10, 2)
  quantity     Int
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model GalleryItem {
  id         String    @id @default(uuid())
  type       MediaType
  filename   String    @unique
  caption    String?
  uploadedBy String
  createdAt  DateTime  @default(now())
  uploader   User      @relation(fields: [uploadedBy], references: [id])

  @@index([createdAt])
}

model Review {
  id        String   @id @default(uuid())
  userId    String   @unique
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  message   String
  createdAt DateTime @default(now())
}

// One support thread per registered customer; the admin sees all threads.
model Conversation {
  id            String   @id @default(uuid())
  userId        String   @unique
  lastMessageAt DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@index([lastMessageAt])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  fromAdmin      Boolean
  body           String
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
