{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "tags": [],
  "targets": {
    "serve": { "executor": "nx:run-commands", "options": { "command": "tsx watch --env-file=.env apps/api/src/server.ts" } },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/api"],
      "options": { "command": "esbuild apps/api/src/server.ts --bundle --platform=node --format=cjs --target=node20 --packages=external --sourcemap --outfile=dist/apps/api/main.js" }
    },
    "typecheck": { "executor": "nx:run-commands", "options": { "command": "tsc -p apps/api/tsconfig.app.json --noEmit" } }
  }
}
