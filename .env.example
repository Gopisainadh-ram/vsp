NODE_ENV=development
PORT=4000

# Your LOCAL PostgreSQL. Create an empty database called "vsp" first.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/vsp?schema=public

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-secret
OTP_HMAC_SECRET=replace-with-a-random-secret

CORS_ORIGINS=http://localhost:4200
COOKIE_SECURE=false
UPLOAD_DIR=./uploads

# Client's WhatsApp number: country code + number, digits only (e.g. 919876543210)
WHATSAPP_ADMIN_NUMBER=91XXXXXXXXXX
# Optional: WhatsApp Cloud API. Empty = customer gets a "Send order on WhatsApp" button.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Optional: email OTP (smtps://user:pass@host). Empty in development = code printed in the terminal.
SMTP_URL=
MAIL_FROM="admin@example.com"

# Used only by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
